#ddev-generated

# The sqlsrv/pdo_sqlsrv versions are tied to the PHP version:
# - PHP 7.0-8.2: use PECL to pin to the last release that supports it, see https://github.com/microsoft/msphpsql/releases
# - PHP 8.3: use PIE to pin to the last release that supports it
# - PHP 8.4+: use PIE to install the latest version, see https://github.com/microsoft/msphpsql_sqlsrv
RUN --mount=type=secret,id=github_token <<'EOF'
set -eu -o pipefail

PECL_VERSION=""
PIE_VERSION=""
case "${DDEV_PHP_VERSION}" in
  5.6) echo "sqlsrv/pdo_sqlsrv are not available for PHP ${DDEV_PHP_VERSION} on Linux, use PHP 7.0+" >&2; exit 1 ;;
  7.0) PECL_VERSION=5.3.0 ;;
  7.1) PECL_VERSION=5.6.1 ;;
  7.2) PECL_VERSION=5.8.1 ;;
  7.3) PECL_VERSION=5.9.0 ;;
  7.4) PECL_VERSION=5.10.1 ;;
  8.0) PECL_VERSION=5.11.1 ;;
  8.1|8.2) PECL_VERSION=5.12.0 ;;
  # 5.14.0 dropped PHP 8.3, but its composer.json still allows it, so PIE would pick it and fail to build
  # See https://github.com/microsoft/msphpsql/issues/1696
  8.3) PIE_VERSION=5.13.3 ;;
  *) PIE_VERSION="*" ;;
esac
case "${DDEV_PHP_VERSION}" in
  7.0|7.1|7.2|7.3)
    # sqlsrv/pdo_sqlsrv older than 5.10 don't support ODBC Driver 18
    MSSQL_PACKAGES="msodbcsql17 mssql-tools"
    MSSQL_TOOLS_BIN="/opt/mssql-tools/bin"
    # phpize from PHP 7.0-7.3 generates a configure script that relies on $SED being set
    export SED=sed
    ;;
  *)
    MSSQL_PACKAGES="msodbcsql18 mssql-tools18"
    MSSQL_TOOLS_BIN="/opt/mssql-tools18/bin"
    ;;
esac

. /etc/os-release
curl -fsSL -o /tmp/packages-microsoft-prod.deb "https://packages.microsoft.com/config/debian/${VERSION_ID}/packages-microsoft-prod.deb"
dpkg -i /tmp/packages-microsoft-prod.deb
rm -f /tmp/packages-microsoft-prod.deb

apt-get update || true
ACCEPT_EULA=Y DEBIAN_FRONTEND=noninteractive apt-get install -y \
  -o Dpkg::Options::="--force-confold" \
  --no-install-recommends --no-install-suggests \
  ${MSSQL_PACKAGES} \
  build-essential \
  dialog \
  php-pear \
  "php${DDEV_PHP_VERSION}-dev" \
  unixodbc-common \
  unixodbc-dev \
  locales
apt-get autoremove -y
apt-get clean -y
rm -rf /var/lib/apt/lists/*

ln -sf "${MSSQL_TOOLS_BIN}/sqlcmd" "${MSSQL_TOOLS_BIN}/bcp" /usr/local/bin/

if [ -n "${PECL_VERSION}" ]; then
  pecl channel-update pecl.php.net || true
  # Install one package per command: pecl exits 0 when installing several packages and only some of them fail
  pecl -d php_suffix="${DDEV_PHP_VERSION}" install "sqlsrv-${PECL_VERSION}"
  pecl -d php_suffix="${DDEV_PHP_VERSION}" install "pdo_sqlsrv-${PECL_VERSION}"
  echo 'extension=sqlsrv.so' > "/etc/php/${DDEV_PHP_VERSION}/mods-available/sqlsrv.ini"
  echo 'extension=pdo_sqlsrv.so' > "/etc/php/${DDEV_PHP_VERSION}/mods-available/pdo_sqlsrv.ini"
  phpenmod -v "${DDEV_PHP_VERSION}" sqlsrv pdo_sqlsrv
elif [ -n "${PIE_VERSION}" ]; then
  curl -fsSL -o /usr/local/bin/pie \
    https://github.com/php/pie/releases/latest/download/pie.phar
  chmod +x /usr/local/bin/pie
  if [ -s /run/secrets/github_token ]; then
    token=$(cat /run/secrets/github_token)
    export COMPOSER_AUTH="{\"github-oauth\":{\"github.com\":\"${token}\"}}"
  fi
  pie install --with-php-config="/usr/bin/php-config${DDEV_PHP_VERSION}" \
    "microsoft/sqlsrv:${PIE_VERSION}" "microsoft/pdo_sqlsrv:${PIE_VERSION}"
else
  echo "No sqlsrv/pdo_sqlsrv version is set for PHP ${DDEV_PHP_VERSION}" >&2
  exit 1
fi
EOF
